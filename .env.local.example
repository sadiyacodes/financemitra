# ──────────────────────────────────────────────────────────────────────────────
# FinanceMitra — Environment Variables
#
# LLM provider priority: Ollama (local) → Claude (cloud) → Gemini (cloud)
# At least one cloud provider key is recommended for production use.
# ──────────────────────────────────────────────────────────────────────────────

# 1. Ollama (primary — runs locally, no key needed)
#    Set the model name if you want something other than llama3.
#    Example models: llama3, gemma2, mistral, phi3
OLLAMA_MODEL="llama3"

# 2. Amazon Bedrock (primary cloud fallback)
#    Recommended model for FinanceMitra: qwen.qwen3-32b-v1:0
#    If you have an inference profile for another model, set BEDROCK_MODEL accordingly.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_REGION="us-west-2"
BEDROCK_MODEL="qwen.qwen3-32b-v1:0"

# 3. Anthropic / Claude (first cloud fallback)
#    Get your key at: https://console.anthropic.com/
#    Supported models: claude-sonnet-4-5, claude-opus-4-5, claude-haiku-4-5-20251001
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
CLAUDE_MODEL="claude-sonnet-4-5"

# 3. Google Gemini (second cloud fallback)
#    Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
