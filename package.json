{
  "name": "financemitra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:prompts": "promptfoo eval --config tests/promptfoo/promptfooconfig.yaml --env-file .env.local --max-concurrency 1 --delay 2000",
    "test:prompts:claude": "promptfoo eval --config tests/promptfoo/promptfooconfig.yaml --env-file .env.local --providers anthropic:claude-sonnet-4-5 --max-concurrency 1 --delay 1000",
    "test:prompts:ollama": "promptfoo eval --config tests/promptfoo/promptfooconfig.yaml --env-file .env.local --providers ollama:gemma4:e4b --max-concurrency 1",
    "test:prompts:gemini": "promptfoo eval --config tests/promptfoo/promptfooconfig.yaml --env-file .env.local --providers google:gemini-2.5-flash-lite --max-concurrency 1 --delay 4000",
    "test:prompts:view": "promptfoo view",
    "test:comprehensive": "promptfoo eval --config tests/promptfoo/suites/10_comprehensive.yaml --env-file .env.local --providers bedrock:qwen.qwen3-32b-v1:0 --max-concurrency 1 --delay 1000",
    "test:comprehensive:claude": "promptfoo eval --config tests/promptfoo/suites/10_comprehensive.yaml --env-file .env.local --providers anthropic:claude-sonnet-4-5 --max-concurrency 1 --delay 1500",
    "test:comprehensive:all": "promptfoo eval --config tests/promptfoo/suites/10_comprehensive.yaml --env-file .env.local --max-concurrency 1 --delay 2000"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1046.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "promptfoo": "^0.121.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
